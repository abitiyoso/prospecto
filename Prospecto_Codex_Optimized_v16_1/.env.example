# Copy to .env.local using a running local or explicitly selected Supabase project.
# Server-only workflows require SUPABASE_SECRET_KEY below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_TELEMETRY_DISABLED=1
# Server-side only; never prefix with NEXT_PUBLIC_.
FIRECRAWL_API_KEY=
SUPABASE_SECRET_KEY=
APP_BASE_URL=http://127.0.0.1:3000
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PROSPECTO_ENCRYPTION_KEY=
WORKER_SECRET=
PRESENTATION_MODE=true
# Comma-separated application login emails allowed to activate presentation access.
PRESENTATION_OWNER_EMAIL=hello@elenio.id
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@elenio.id
SMTP_FROM=hello@elenio.id
SMTP_FROM_NAME=Prospecto by Elenio
SMTP_PASS=
# Keep allowlist for demos, including HTTPS. Set live explicitly on the public HTTPS origin when ready.
SMTP_DELIVERY_MODE=allowlist
# Comma-separated approved test destinations.
SMTP_PRESENTATION_RECIPIENTS=hello@elenio.id
# Server-side AI connection. Use an API key issued by the hosted 9Router dashboard.
AI_PROVIDER=9router
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional reasoning effort, supported values depend on the selected model.
AI_REASONING_EFFORT=
NINE_ROUTER_BASE_URL=https://9router.elenio.id/v1
NINE_ROUTER_API_KEY=
NINE_ROUTER_MODEL=cx/gpt-6-luna
