// HTTP-only acceptance. Leaves a short-lived isolated QA login for browser verification.
import {request,expect} from '@playwright/test';
import {createClient} from '@supabase/supabase-js';
import {randomUUID,randomBytes} from 'node:crypto';
import {mkdir,writeFile,readFile,unlink} from 'node:fs/promises';
process.loadEnvFile('.env.local');
const dir='qa/journey-20261107',base=process.env.QA_BASE_URL||'http://127.0.0.1:3001',sessionFile='.env.journey-qa';await mkdir(dir,{recursive:true});
const admin=createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.SUPABASE_SECRET_KEY!,{auth:{persistSession:false}});
if(process.argv.includes('--cleanup')){const session=JSON.parse(await readFile(sessionFile,'utf8'));const banned=await admin.auth.admin.updateUserById(session.userId,{ban_duration:'876000h'});if(banned.error)throw Error('QA cleanup failed');await unlink(sessionFile);try{const result=JSON.parse(await readFile(dir+'/api-results.json','utf8'));await writeFile(dir+'/api-results.json',JSON.stringify({...result,qaLoginPendingBrowserVerification:false,qaUsersBanned:1},null,2));}catch{}console.log('Isolated QA login banned; temporary credential file removed.');process.exit(0);}
const previous=process.argv.includes('--resume')?JSON.parse(await readFile(sessionFile,'utf8')):null;
const login=previous?{email:previous.email,password:previous.password}:{email:'prospecto-journey-'+randomUUID()+'@example.com',password:randomBytes(32).toString('base64url')},client=createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY!,{auth:{persistSession:false}}),http=await request.newContext({timeout:120000});
let userId='',w='',passed=false,stage='setup';const checks:string[]=[],evidence:Record<string,unknown>={};
function must<T>(r:{data:T;error:unknown}):NonNullable<T>{if(r.error)throw Error('QA database operation failed');return r.data as NonNullable<T>;}
async function post(path:string,action:string,extra:Record<string,unknown>={},status=200){const r=await http.post(base+path,{headers:{origin:base},data:{workspace_id:w,action,...extra}}),v=await r.json();if(r.status()!==status)throw Error('QA '+action+' HTTP '+r.status()+' ('+(v.error||v.code||'unknown')+')');return v;}
const cmd=(action:string,extra:Record<string,unknown>={})=>post('/api/command',action,extra);
try{
 userId=previous?.userId||must(await admin.auth.admin.createUser({...login,email_confirm:true})).user.id;must(await client.auth.signInWithPassword(login));await post('/auth/action','login',login);if(previous)w=previous.workspaceId;else{await cmd('workspace.create',{name:'Isolated prospect journey QA'});w=must(await client.from('workspaces').select('id').single()).id;}
 const p=previous?.productId||(await cmd('product.save',{values:{name:'QA Journey Product',category:'Software / SaaS',industry:'Teknologi / Software',buyer_roles:'CEO / Direktur, Operations Manager',value_proposition:'Mengelola pengetahuan produk.'}})).id;expect(p).toBeTruthy();await cmd('icp.save',{values:{product_id:p,industry:'Manufaktur',location:'Jakarta',buyer_roles:'President Director'}});checks.push('Product choice values and multiple buyer roles persist; product.save returns the saved product ID');
 await writeFile(sessionFile,JSON.stringify({...login,userId,workspaceId:w,productId:p,base}));
 stage='company_discovery';console.log('Finding actual company names from official public pages...');const companyRun=(await post('/api/research','search',{product_id:p,kind:'company',query:'site:astra.co.id Astra International official company'})).run;expect(companyRun.status).toBe('completed');const companies=companyRun.results.flatMap((s:any)=>s.candidates||[]);evidence.companyCandidates=companies.map((c:any)=>({name:c.name,domain:c.domain,source_url:c.source_url}));evidence.companyError=companyRun.error_code;await writeFile(dir+'/progress.json',JSON.stringify({stage,evidence},null,2));
 expect(companies.length,'No grounded company candidates; error '+companyRun.error_code).toBeGreaterThan(0);const co=companies.find((c:any)=>c.domain==='astra.co.id')||companies[0];await cmd('company.save',{values:{name:co.name,domain:co.domain,industry:co.industry,location:co.location,source_url:co.source_url}});const company=must(await client.from('companies').select('id,name,domain').eq('workspace_id',w).eq('domain',co.domain).single());checks.push('Actual company name/domain extracted from official evidence, then saved after review');
 stage='pic_discovery';console.log('Finding actual PIC names and roles on the selected company domain...');const run=(await post('/api/research','search',{product_id:p,company_id:company.id,kind:'pic',query:'direksi board of directors'})).run;expect(run.status).toBe('completed');const people=run.results.flatMap((s:any)=>s.candidates||[]);evidence.picCandidates=people.map((c:any)=>({name:c.name,title:c.title,hasPublishedEmail:!!c.email,source_url:c.source_url}));evidence.picError=run.error_code;await writeFile(dir+'/progress.json',JSON.stringify({stage,evidence},null,2));expect(people.length,'No grounded people; error '+run.error_code).toBeGreaterThan(0);
 const person=people[0],values={company_id:company.id,name:person.name,title:person.title,email:person.email,source_url:person.source_url,notes:person.evidence};const first=await cmd('pic.save',{values}),again=await cmd('pic.save',{values});expect(again.id).toBe(first.id);const pic=must(await client.from('pic_candidates').select('*').eq('workspace_id',w).single());expect(pic.verification).toBe('candidate');expect(pic.name).toBe(person.name);expect(pic.notes).toBe(person.evidence);
 const saved=must(await client.from('research_runs').select('results').eq('id',run.id).single());expect(saved.results.flatMap((s:any)=>s.candidates||[]).some((c:any)=>c.name===person.name)).toBe(true);expect(must(await client.from('contacts').select('id').eq('workspace_id',w))).toEqual([]);checks.push('Real named PIC/title/evidence persist with research history and as unverified candidate, without automatic Lead promotion or sending');
 await writeFile(sessionFile,JSON.stringify({...login,userId,workspaceId:w,productId:p,companyId:company.id,personName:person.name,base}));passed=true;
}catch(e){console.error('Journey QA failed at '+stage+': '+(e instanceof Error?e.message:'unknown'));process.exitCode=1;}finally{
 await http.dispose();await client.auth.signOut({scope:'global'});await writeFile(dir+'/api-results.json',JSON.stringify({passed,stage,checks,evidence,emailsSent:0,campaignsLaunched:0,qaLoginPendingBrowserVerification:true,at:new Date().toISOString()},null,2));console.log(JSON.stringify({passed,stage,checks,evidence}));
}
