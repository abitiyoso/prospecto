if(process.argv.includes('--cleanup')){const q=JSON.parse(await readFile(file,'utf8'));const launches=must(await admin.from('campaign_launches').select('id').eq('workspace_id',q.w));if(launches.length){must(await admin.from('campaign_launches').update({state:'canceled'}).eq('workspace_id',q.w));must(await admin.from('outbound_jobs').update({state:'canceled'}).in('launch_id',launches.map(l=>l.id)).in('state',['pending','manual','processing']));}const senders=must(await admin.from('channel_connections').select('id').eq('workspace_id',q.w));if(senders.length)must(await admin.from('smtp_credentials').delete().in('connection_id',senders.map(s=>s.id)));must(await admin.auth.admin.updateUserById(q.userId,{ban_duration:'876000h'}));await unlink(file);console.log('QA account banned and sender credentials removed; queued QA work canceled.');process.exit(0);}
const send=process.argv.includes('--send-self-test'),fixtureOnly=process.argv.includes('--fixture-only'),profileOnly=process.argv.includes('--profile-only'),reuse=profileOnly||process.argv.includes('--reuse-discovery');
const resume=send||fixtureOnly||reuse||process.argv.includes('--resume');const q:any=resume?JSON.parse(await readFile(file,'utf8')):{email:'prospecto-flow-'+randomUUID()+'@example.com',password:randomBytes(32).toString('base64url')};
const http=await request.newContext({timeout:180000}),client=createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY!,{auth:{persistSession:false}});
const checks:string[]=[],evidence:Record<string,unknown>={};let passed=false,stage='setup';
async function post(path:string,action:string,extra:Record<string,unknown>={},status=200){const r=await http.post(base+path,{headers:{origin:base},data:{action,workspace_id:q.w,...extra}}),v=await r.json();if(r.status()!==status)throw Error(action+' HTTP '+r.status()+' '+(v.error||v.code||''));return v;}
const cmd=(a:string,x:Record<string,unknown>={},status=200)=>post('/api/command',a,x,status),flow=(a:string,x:Record<string,unknown>={},status=200)=>post('/api/workflow',a,x,status);
try{
 if(!resume)q.userId=must(await admin.auth.admin.createUser({email:q.email,password:q.password,email_confirm:true})).user.id;
 must(await client.auth.signInWithPassword({email:q.email,password:q.password}));await post('/auth/action','login',{email:q.email,password:q.password});
 if(!resume){await cmd('workspace.create',{name:'Isolated product to campaign QA'});q.w=must(await client.from('workspaces').select('id').single()).id;q.p=(await cmd('product.save',{values:{name:'QA Rental Operations',category:'Software / SaaS',industry:'Kos / Properti sewa',buyer_roles:'CEO / Direktur, Operations Manager',pain_points:'Operator kos dengan banyak unit harus mengelola tagihan dan operasional kamar.',value_proposition:'Mengelola billing sewa dan smart room untuk pengelola kos dan properti sewa.'}})).id;await cmd('source.add',{values:{product_id:q.p,kind:'note',title:'QA approved product capabilities',content:'Mengelola billing sewa dan smart room untuk pengelola kos dan properti sewa. Tidak ada klaim kenaikan pendapatan. Memerlukan tinjauan kebutuhan operator.'}});const source=must(await client.from('knowledge_sources').select('id').eq('workspace_id',q.w).single());await flow('kms.index',{source_id:source.id});await cmd('icp.save',{values:{product_id:q.p,industry:'Kos / Properti sewa',location:'Jakarta',buyer_roles:'CEO / Direktur'}});await writeFile(file,JSON.stringify(q));}
 if(!send&&!fixtureOnly){
  stage='product-fit';console.log('Checking buyers discovered from product capabilities and KMS...');const run=reuse?must(await client.from('research_runs').select('query,results,error_code').eq('workspace_id',q.w).eq('product_id',q.p).eq('kind','company').eq('status','completed').order('created_at',{ascending:false}).limit(1).single()):(await post('/api/research','search',{product_id:q.p,kind:'company',query:''})).run;const candidates=run.results.flatMap((s:any)=>s.candidates||[]);evidence.query=run.query;evidence.error=run.error_code;evidence.companies=candidates.map((c:any)=>({name:c.name,domain:c.domain,profile:c.profile_quote,fit:c.fit_reasons,source_url:c.source_url}));await writeFile(dir+'/live-progress.json',JSON.stringify(evidence,null,2));const co=candidates.find((c:any)=>c.profile_quote&&c.fit_reasons?.length&&(!process.env.QA_COMPANY_DOMAIN||c.domain===process.env.QA_COMPANY_DOMAIN));expect(co,'No grounded profile/product-fit output').toBeTruthy();await cmd('company.save',{values:{name:co.name,domain:co.domain,industry:co.industry,location:co.location,source_url:co.source_url}});q.realCompany=must(await client.from('companies').select('id,name,domain').eq('workspace_id',q.w).eq('domain',co.domain).single());const profile=await cmd('company.profile',{product_id:q.p,company_id:q.realCompany.id});expect(profile.candidate?.fit_reasons.length).toBeGreaterThan(0);expect(profile.candidate.profile_quote).toBe(co.profile_quote);checks.push('No-keyword search plans from product/KMS; actual company profile and product/company evidence pairs persist per product');await writeFile(file,JSON.stringify(q));
  if(!profileOnly){stage='decision-makers';console.log('Finding named decision-maker candidates in the selected company...');const people=(await post('/api/research','search',{product_id:q.p,company_id:q.realCompany.id,kind:'pic',scope:'public',query:''})).run;const names=people.results.flatMap((s:any)=>s.candidates||[]);evidence.people=names.map((c:any)=>({name:c.name,title:c.title,source_url:c.source_url,hasPublicEmail:!!c.email,roleFit:c.fit_reasons}));evidence.picError=people.error_code;await writeFile(dir+'/live-progress.json',JSON.stringify(evidence,null,2));expect(names.length,'No public named decision maker on selected company').toBeGreaterThan(0);const person=names[0];await cmd('pic.save',{values:{company_id:q.realCompany.id,name:person.name,title:person.title,email:person.email,source_url:person.source_url,notes:person.evidence}});checks.push('Decision-maker search restricted to selected company; sourced name/title persist as a candidate, not an automatic verified contact');}
 }
 if(!send&&!profileOnly){
  stage='campaign-draft';
  // Separate, clearly labeled QA identities exercise campaign selection and own-mail SMTP.
  await cmd('company.save',{values:{name:'QA Controlled Rental Operator',domain:'example.com',source_url:'https://example.com/'}});const fixture=must(await client.from('companies').select('id').eq('workspace_id',q.w).eq('domain','example.com').single());q.fixtureCompanyId=fixture.id;q.selected=(await cmd('pic.save',{values:{company_id:fixture.id,name:'QA Own Mailbox',title:'QA Operations',email:'hello@elenio.id',source_url:'https://example.com/qa',verification:'verified',notes:'Controlled QA identity, not a discovered employee. Own mailbox only.'}})).id;q.unselected=(await cmd('pic.save',{values:{company_id:fixture.id,name:'QA Not Selected',title:'QA Finance',email:'abitiyoso@gmail.com',source_url:'https://example.com/qa',verification:'verified'}})).id;q.draftId=randomUUID();q.campaignName='QA selected PIC workflow';
  const draft=await cmd('campaign.from_pics',{product_id:q.p,pic_ids:[q.selected],name:q.campaignName,request_id:q.draftId});expect((await cmd('campaign.from_pics',{product_id:q.p,pic_ids:[q.selected],name:q.campaignName,request_id:q.draftId})).id).toBe(draft.id);const saved=must(await client.from('campaigns').select('product_id,status,campaign_audience(contacts(name,email))').eq('workspace_id',q.w).eq('id',draft.id).single());expect(saved.product_id).toBe(q.p);expect(saved.status).toBe('draft');expect(saved.campaign_audience).toHaveLength(1);expect((saved.campaign_audience[0].contacts as any).email).toBe('hello@elenio.id');checks.push('Controlled QA selection creates an idempotent product-bound draft with exactly the selected PIC; eligible unselected PIC excluded; zero automatic launch');q.campaign=draft.id;await writeFile(file,JSON.stringify(q));
 }else if(send){
  stage='selected-campaign';if(process.env.QA_CAMPAIGN_NAME){q.campaignName=process.env.QA_CAMPAIGN_NAME;q.campaign=must(await client.from('campaigns').select('id').eq('workspace_id',q.w).eq('name',q.campaignName).eq('product_id',q.p).single()).id;}const selected=must(await client.from('campaigns').select('status,product_id,campaign_audience(contact_id,contacts(email))').eq('workspace_id',q.w).eq('id',q.campaign).single());expect(selected.status).toBe('draft');expect(selected.product_id).toBe(q.p);expect(selected.campaign_audience).toHaveLength(1);expect((selected.campaign_audience[0].contacts as any).email).toBe('hello@elenio.id');expect(must(await admin.from('campaign_launches').select('id').eq('workspace_id',q.w))).toHaveLength(0);
  const generated=(await flow('leo.generate',{product_id:q.p,campaign_id:q.campaign,engine:'ai',instruction:'Buat email perkenalan singkat berdasarkan manfaat produk dan fungsi peran audiens terpilih. Gunakan dan cantumkan sumber campaign-audience. Ini pengujian ke mailbox milik sendiri; jangan mengklaim kebutuhan penerima sudah dikonfirmasi.'})).run;expect(generated.engine).toBe('9router');expect(generated.source_refs.some((s:any)=>s.source_id==='campaign-audience')).toBe(true);evidence.leo={engine:generated.engine,model:generated.model,audienceContext:true};checks.push('Real 9Router draft uses the selected campaign audience roles plus product/KMS context');
  stage='own-mail-smtp';must(await admin.from('presentation_access').upsert({workspace_id:q.w,granted_by:q.userId}));await flow('smtp.connect',{preset:true});await cmd('campaign.save',{id:q.campaign,contact_ids:[selected.campaign_audience[0].contact_id],values:{name:q.campaignName,product_id:q.p,sender_name:'Prospecto QA',steps:[{kind:'email',subject:'Prospecto QA · selected PIC workflow',body:generated.result.body+'\n\nIni uji fungsi ke mailbox milik sendiri. Tidak perlu membalas.',days:1}]}});await cmd('campaign.approve',{id:q.campaign});const launch=(await flow('outreach.launch',{campaign_id:q.campaign,consent:true,confirm:true})).id;await flow('outreach.process');const job=must(await admin.from('outbound_jobs').select('state,message_id').eq('launch_id',launch).eq('step_index',0).single());expect(job.state).toBe('sent');expect(job.message_id).toBeTruthy();evidence.smtp={recipient:'hello@elenio.id',state:job.state,acceptedMessageIdRecorded:!!job.message_id};checks.push('Approved controlled campaign processes once through Hostinger to own hello@elenio.id only; unselected QA address never enters audience');
 }
 passed=true;
}catch(e){console.error('Flow QA failed at '+stage+': '+(e instanceof Error?e.message:'unknown'));process.exitCode=1;}finally{await client.auth.signOut({scope:'local'});await http.dispose();const result={passed,stage,checks,evidence,isolatedQA:true,at:new Date().toISOString()};if(!profileOnly)await writeFile(dir+(send?'/campaign-results.json':fixtureOnly?'/draft-results.json':'/discovery-results.json'),JSON.stringify(result,null,2));console.log(JSON.stringify({passed,stage,checks}));}
