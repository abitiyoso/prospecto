import {request,expect} from '@playwright/test';
import {createClient} from '@supabase/supabase-js';
import {randomUUID,randomBytes} from 'node:crypto';
import {writeFile,mkdir} from 'node:fs/promises';
import {pdfFixture} from '../tests/pdf-fixture';
process.loadEnvFile('.env.local');
const output=process.env.QA_OUTPUT_DIR||'qa/presentation';await mkdir(output,{recursive:true});
const origin=process.env.QA_BASE_URL||'http://127.0.0.1:3000',admin=createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.SUPABASE_SECRET_KEY!,{auth:{persistSession:false}}),client=createClient(process.env.NEXT_PUBLIC_SUPABASE_URL!,process.env.NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY!,{auth:{persistSession:false}}),http=await request.newContext();
const login={email:'prospecto-presentation-'+randomUUID()+'@example.com',password:randomBytes(32).toString('base64url')},u=await admin.auth.admin.createUser({...login,email_confirm:true});if(u.error)throw Error('QA user unavailable');const id=u.data.user.id,w=randomUUID(),p=randomUUID();let passed=false;
try{expect((await client.auth.signInWithPassword(login)).error).toBeNull();expect((await http.post(origin+'/auth/action',{headers:{origin},data:{action:'login',...login}})).status()).toBe(200);expect((await client.from('workspaces').insert({id:w,name:'Isolated PDF QA',created_by:id})).error).toBeNull();expect((await client.from('products').insert({id:p,workspace_id:w,name:'PDF QA'})).error).toBeNull();
 const upload=await http.post(origin+'/api/upload',{headers:{origin},multipart:{workspace_id:w,product_id:p,file:{name:'qa-material.pdf',mimeType:'application/pdf',buffer:pdfFixture()}}});expect(upload.status(),await upload.text()).toBe(200);
 const s=await client.from('knowledge_sources').select('id').eq('workspace_id',w).single();expect(s.error).toBeNull();const index=await http.post(origin+'/api/workflow',{headers:{origin},data:{workspace_id:w,action:'kms.index',source_id:s.data!.id}});if(index.status()!==200)throw Error('KMS PDF: '+await index.text());expect((await index.json()).chunks).toBeGreaterThan(0);
 const search=await http.post(origin+'/api/workflow',{headers:{origin},data:{workspace_id:w,action:'kms.search',product_id:p,query:'Alpha PDF'}});expect((await search.json()).results[0].excerpt).toContain('Alpha PDF');passed=true;
}finally{const sources=(await admin.from('knowledge_sources').select('storage_path').eq('workspace_id',w)).data||[];const paths=sources.map(s=>s.storage_path).filter(Boolean);if(paths.length)await admin.storage.from('product-kms').remove(paths);await client.auth.signOut({scope:'global'});await admin.auth.admin.updateUserById(id,{ban_duration:'876000h'});await http.dispose();await writeFile(output+'/pdf-results.json',JSON.stringify({passed,actualHostedUploadAndNextRuntime:true},null,2));console.log(JSON.stringify({passed}));}
